# Local dev defaults. Copy to `.env` and tweak as needed.

# Service ports
ACTION_SERVICE_PORT=8081
COMPANY_SERVICE_PORT=8082
DATA_GENERATOR_SERVICE_PORT=8083
RATING_SERVICE_PORT=8084
USER_SERVICE_PORT=8085
ACTIVITY_SERVICE_PORT=8086

# Database configuration
MYSQL_DATABASE=fuel50
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=changeme

# Spring R2DBC (MySQL over R2DBC)
SPRING_R2DBC_URL=r2dbc:mysql://db:3306/${MYSQL_DATABASE}
SPRING_R2DBC_USERNAME=${MYSQL_USER}
SPRING_R2DBC_PASSWORD=${MYSQL_PASSWORD}

# Disable Spring's SQL init (we mount schema.sql into MySQL)
SPRING_SQL_INIT_MODE=never

# Ollama
OLLAMA_MODEL=llama3
SPRING_AI_OLLAMA_BASE_URL=http://ollama:11434/
SPRING_AI_OLLAMA_CHAT_OPTIONS_MODEL=llama3
SPRING_AI_OLLAMA_CHAT_OPTIONS_TEMPERATURE=0.0

# Client base URLs for data-generator-service
CLIENTS_COMPANY_BASE_URL=http://company-service:${COMPANY_SERVICE_PORT}
CLIENTS_USER_BASE_URL=http://user-service:${USER_SERVICE_PORT}
CLIENTS_ACTIVITY_BASE_URL=http://activity-service:${ACTIVITY_SERVICE_PORT}
CLIENTS_ACTION_BASE_URL=http://action-service:${ACTION_SERVICE_PORT}
CLIENTS_USER_ACTIVITY_BASE_URL=http://activity-service:${ACTIVITY_SERVICE_PORT}